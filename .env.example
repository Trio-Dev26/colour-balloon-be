PORT=3001
CORS_ORIGIN=http://localhost:3000

# Object storage (S3-compatible). Local dev points at the MinIO container
# below; production should point at Cloudflare R2 (or another provider) —
# see README for the R2 values to use.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=colour-balloon
STORAGE_FORCE_PATH_STYLE=true

# MinIO container config (docker-compose, local dev only)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
