// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED

  @@map("module_status")
}

model User {
  id       String @id @default(uuid(7)) @db.Uuid()
  userId   String @unique @default(dbgenerated("next_user_id()")) @map("user_id")
  username String @unique
  fullname String
  email    String @unique
  password String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @map("role_id") @db.Uuid()

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id    String @id @default(uuid(7)) @db.Uuid()
  name  String @unique
  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Level {
  id        String   @id @default(uuid(7)) @db.Uuid()
  code      String   @unique @db.VarChar
  titleEn   String   @map("title_en") @db.VarChar
  titleMy   String   @map("title_my") @db.VarChar
  modules   Module[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("levels")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid()
  code      String   @unique @db.VarChar
  titleEn   String   @map("title_en") @db.VarChar
  titleMy   String   @map("title_my") @db.VarChar
  modules   Module[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Module {
  id                String       @id @default(uuid(7)) @db.Uuid()
  code              String       @unique @db.VarChar
  titleEn           String       @map("title_en") @db.VarChar
  titleMy           String       @map("title_my") @db.VarChar
  descriptionEn     Json         @map("description_en") @db.JsonB
  descriptionMy     Json         @map("description_my") @db.JsonB
  learningGoalEn    String       @map("learning_goal_en") @db.VarChar
  learningGoalMy    String       @map("learning_goal_my") @db.VarChar
  learningOutcomeEn Json         @map("learning_outcome_en") @db.JsonB
  learningOutcomeMy Json         @map("learning_outcome_my") @db.JsonB
  status            ModuleStatus @default(DRAFT)
  level             Level        @relation(fields: [levelId], references: [id])
  levelId           String       @map("level_id") @db.Uuid()
  category          Category     @relation(fields: [categoryId], references: [id])
  categoryId        String       @map("category_id") @db.Uuid()
  units             Unit[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  /// Set when an admin deletes the module (PRD FR-CUR-012: hidden, not erased).
  deletedAt         DateTime?    @map("deleted_at")

  // Titles stay unique among live modules only, so a deleted module frees its title.
  @@unique([titleEn], map: "modules_title_en_key", where: raw("deleted_at IS NULL"))
  @@unique([titleMy], map: "modules_title_my_key", where: raw("deleted_at IS NULL"))
  @@index([levelId, categoryId])
  @@map("modules")
}

model Unit {
  id            String   @id @default(uuid(7)) @db.Uuid()
  code          String   @unique @db.VarChar
  /// Display and unlock order inside the module; independent of the code.
  sequence      Int
  titleEn       String   @map("title_en") @db.VarChar
  titleMy       String   @map("title_my") @db.VarChar
  descriptionEn Json     @map("description_en") @db.JsonB
  descriptionMy Json     @map("description_my") @db.JsonB
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId      String   @map("module_id") @db.Uuid()
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  /// Set when an admin deletes the unit, or its module (PRD FR-CUR-012).
  deletedAt     DateTime? @map("deleted_at")

  @@index([moduleId, sequence])
  @@map("units")
}

/// Last number handed out per code prefix ("FM", "FM01-U", ...), so codes of
/// deleted records are never reused.
model CodeSequence {
  scope     String @id @db.VarChar
  lastValue Int    @map("last_value")

  @@map("code_sequences")
}
