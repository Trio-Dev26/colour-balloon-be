// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ModuleStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED

  @@map("module_status")
}

/// The four file groups of a lesson (PRD FR-FILE-001). Students only ever see
/// STUDENT_* files and teachers only TEACHER_* files (FR-FILE-004).
enum LessonFileGroup {
  STUDENT_VIEW
  STUDENT_DOWNLOAD
  TEACHER_VIEW
  TEACHER_DOWNLOAD

  @@map("lesson_file_group")
}

/// PRD FR-QB-003..007, Decision Log D22/D23. The answers JSON shape depends on it.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  MATCHING
  SEQUENCE

  @@map("question_type")
}

/// Decision Log D16: a unit quiz has a unit; the Chapter End Test covers the module.
enum QuizType {
  UNIT_QUIZ
  CHAPTER_END_TEST

  @@map("quiz_type")
}

model User {
  id       String @id @default(uuid(7)) @db.Uuid()
  userId   String @unique @default(dbgenerated("next_user_id()")) @map("user_id")
  username String @unique
  fullname String
  email    String @unique
  password String

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @map("role_id") @db.Uuid()

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id    String @id @default(uuid(7)) @db.Uuid()
  name  String @unique
  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Level {
  id        String   @id @default(uuid(7)) @db.Uuid()
  code      String   @unique @db.VarChar
  titleEn   String   @map("title_en") @db.VarChar
  titleMy   String   @map("title_my") @db.VarChar
  modules   Module[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("levels")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid()
  code      String   @unique @db.VarChar
  titleEn   String   @map("title_en") @db.VarChar
  titleMy   String   @map("title_my") @db.VarChar
  modules   Module[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Module {
  id                String       @id @default(uuid(7)) @db.Uuid()
  code              String       @unique @db.VarChar
  titleEn           String       @map("title_en") @db.VarChar
  titleMy           String       @map("title_my") @db.VarChar
  descriptionEn     Json         @map("description_en") @db.JsonB
  descriptionMy     Json         @map("description_my") @db.JsonB
  learningGoalEn    String       @map("learning_goal_en") @db.VarChar
  learningGoalMy    String       @map("learning_goal_my") @db.VarChar
  learningOutcomeEn Json         @map("learning_outcome_en") @db.JsonB
  learningOutcomeMy Json         @map("learning_outcome_my") @db.JsonB
  status            ModuleStatus @default(DRAFT)
  /// Object-storage key of the thumbnail image; served through signed URLs only.
  thumbnailKey      String?      @map("thumbnail_key") @db.VarChar
  level             Level        @relation(fields: [levelId], references: [id])
  levelId           String       @map("level_id") @db.Uuid()
  category          Category     @relation(fields: [categoryId], references: [id])
  categoryId        String       @map("category_id") @db.Uuid()
  units             Unit[]
  quizzes           Quiz[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  /// Set when an admin deletes the module (PRD FR-CUR-012: hidden, not erased).
  deletedAt         DateTime?    @map("deleted_at")

  // Titles stay unique among live modules only, so a deleted module frees its title.
  @@unique([titleEn], map: "modules_title_en_key", where: raw("deleted_at IS NULL"))
  @@unique([titleMy], map: "modules_title_my_key", where: raw("deleted_at IS NULL"))
  @@index([levelId, categoryId])
  @@map("modules")
}

model Unit {
  id            String     @id @default(uuid(7)) @db.Uuid()
  code          String     @unique @db.VarChar
  /// Display and unlock order inside the module; independent of the code.
  sequence      Int
  titleEn       String     @map("title_en") @db.VarChar
  titleMy       String     @map("title_my") @db.VarChar
  descriptionEn Json       @map("description_en") @db.JsonB
  descriptionMy Json       @map("description_my") @db.JsonB
  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId      String     @map("module_id") @db.Uuid()
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  lessons       Lesson[]
  questions     Question[]
  quizzes       Quiz[]
  /// Set when an admin deletes the unit, or its module (PRD FR-CUR-012).
  deletedAt     DateTime?  @map("deleted_at")

  @@index([moduleId, sequence])
  @@map("units")
}

model Lesson {
  id            String       @id @default(uuid(7)) @db.Uuid()
  code          String       @unique @db.VarChar
  /// Display and unlock order inside the unit; independent of the code.
  sequence      Int
  titleEn       String       @map("title_en") @db.VarChar
  titleMy       String       @map("title_my") @db.VarChar
  descriptionEn Json         @map("description_en") @db.JsonB
  descriptionMy Json         @map("description_my") @db.JsonB
  unit          Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId        String       @map("unit_id") @db.Uuid()
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  /// Set when an admin deletes the lesson, or its unit or module (PRD FR-CUR-012).
  deletedAt     DateTime?    @map("deleted_at")
  files         LessonFile[]

  @@index([unitId, sequence])
  @@map("lessons")
}

/// A file in object storage, shown in a lesson in the admin's order (D12).
model LessonFile {
  id          String          @id @default(uuid(7)) @db.Uuid()
  group       LessonFileGroup
  /// Display order inside its group of the lesson.
  sequence    Int
  /// Object key in the private bucket; files are only served via signed URLs.
  storageKey  String          @unique @map("storage_key") @db.VarChar
  /// Original file name, shown to admins and used for downloads.
  fileName    String          @map("file_name") @db.VarChar
  /// Detected from the file's bytes, not the name.
  contentType String          @map("content_type") @db.VarChar
  sizeBytes   Int             @map("size_bytes")
  captionEn   String?         @map("caption_en") @db.VarChar
  captionMy   String?         @map("caption_my") @db.VarChar
  lesson      Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String          @map("lesson_id") @db.Uuid()
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([lessonId, group, sequence])
  @@map("lesson_files")
}

/// Last number handed out per code prefix ("FM", "FM01-U", ...), so codes of
/// deleted records are never reused.
model CodeSequence {
  scope     String @id @db.VarChar
  lastValue Int    @map("last_value")

  @@map("code_sequences")
}

/// A question in the bank. It belongs to one unit for good (D16, D28).
model Question {
  id             String          @id @default(uuid(7)) @db.Uuid()
  code           String          @unique @db.VarChar
  type           QuestionType
  /// Q24: questions are Myanmar-first (the platform teaches Myanmar literacy). The Myanmar prompt is required;
  /// the English one is an optional translation, and FILL_BLANK has none (its blanks are Myanmar words).
  /// Rich-text (TipTap JSON) Myanmar prompt.
  promptMy       Json            @map("prompt_my") @db.JsonB
  /// Plain text of the Myanmar prompt, for search, lists and counting ___ blanks.
  promptTextMy   String          @map("prompt_text_my") @db.VarChar
  /// Optional English translation of the prompt (never for FILL_BLANK).
  promptEn       Json?           @map("prompt_en") @db.JsonB
  promptTextEn   String?         @map("prompt_text_en") @db.VarChar
  /// Images shown with the prompt (rows in question_media).
  promptMediaIds String[]        @default([]) @map("prompt_media_ids") @db.Uuid
  /// Correct answers, shared by both languages; shape per type in src/curriculum/questions/question-answers.ts.
  answers        Json            @db.JsonB
  /// Optional explanations shown after answering (English never for FILL_BLANK).
  explanationMy  Json?           @map("explanation_my") @db.JsonB
  explanationEn  Json?           @map("explanation_en") @db.JsonB
  points         Int
  unit           Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId         String          @map("unit_id") @db.Uuid()
  media          QuestionMedia[]
  quizzes        QuizQuestion[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  /// Set when an admin deletes the question, or its unit or module (PRD FR-CUR-012).
  deletedAt      DateTime?       @map("deleted_at")

  @@index([unitId])
  @@map("questions")
}

/// An image uploaded for a question. questionId stays null until the question
/// that uses it is saved; such rows are unused uploads.
model QuestionMedia {
  id          String    @id @default(uuid(7)) @db.Uuid()
  question    Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId  String?   @map("question_id") @db.Uuid()
  storageKey  String    @unique @map("storage_key") @db.VarChar
  /// Detected from the file's bytes.
  contentType String    @map("content_type") @db.VarChar
  sizeBytes   Int       @map("size_bytes")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([questionId])
  @@map("question_media")
}

model Quiz {
  id            String         @id @default(uuid(7)) @db.Uuid()
  code          String         @unique @db.VarChar
  type          QuizType
  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId      String         @map("module_id") @db.Uuid()
  /// Null for the Chapter End Test. A quiz's unit never changes (D28).
  unit          Unit?          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId        String?        @map("unit_id") @db.Uuid()
  /// Required quizzes block unit completion (D5); the Chapter End Test is always required.
  required      Boolean        @default(true)
  /// Pass when score / total points >= passPercent (D21).
  passPercent   Int            @map("pass_percent")
  /// Attempts before the 24-hour lock; null = unlimited (D24 defaults: unit quiz unlimited, Chapter End Test 3).
  maxAttempts   Int?           @map("max_attempts")
  titleEn       String         @map("title_en") @db.VarChar
  titleMy       String         @map("title_my") @db.VarChar
  descriptionEn Json?          @map("description_en") @db.JsonB
  descriptionMy Json?          @map("description_my") @db.JsonB
  questions     QuizQuestion[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  /// Set when an admin deletes the quiz, or its unit or module (PRD FR-CUR-012).
  deletedAt     DateTime?      @map("deleted_at")

  // One live Chapter End Test per module (D16).
  @@unique([moduleId], map: "quizzes_one_cet_per_module", where: raw("type = 'CHAPTER_END_TEST' AND deleted_at IS NULL"))
  @@index([moduleId])
  @@index([unitId])
  @@map("quizzes")
}

/// The questions of a quiz, in the admin's order. A question appears once per quiz.
model QuizQuestion {
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId     String   @map("quiz_id") @db.Uuid()
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String   @map("question_id") @db.Uuid()
  sequence   Int

  @@id([quizId, questionId])
  @@index([questionId])
  @@map("quiz_questions")
}
